# --- Two Minute Reports ---
# Create a key at https://hub.twominutereports.com/settings?tab=api-keys
# (intended use: API). The key needs data:read and connectors:read, and your
# team role must allow "Query data over MCP and the API".
TMR_API_KEY=
# Your team ID (UUID). Shown in the TMR hub, or via GET /v1/teams.
TMR_TEAM_ID=
# Which connectors to show. fads = Meta (Facebook/Instagram) Ads, ttads = TikTok Ads.
TMR_CONNECTORS=fads,ttads
# Optional: convert all money to one currency so totals across accounts add up.
# TMR_CURRENCY=SGD

# --- Claude analysis (optional) ---
# Get a key at https://platform.claude.com. Leave empty to hide the analysis.
ANTHROPIC_API_KEY=
# ANALYSIS_MODEL=claude-opus-5-5
# ANALYSIS_EFFORT=high
# Images sent per analysis (highest-spend creatives first).
# ANALYSIS_MAX_IMAGES=24

# --- Server ---
PORT=3000
# How long fetched ad data is cached on disk (TMR allows 15 queries/min).
CACHE_TTL_HOURS=12
# Require this password (HTTP basic auth, any username). Set it when hosted on Railway.
# DASHBOARD_PASSWORD=
# Set to 1 to use synthetic demo data (also the default when TMR_API_KEY is empty).
# DEMO_MODE=1
